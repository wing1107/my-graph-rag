# 智谱 AI（默认 Chat / Zhipu Embedding）
ZHIPUAI_API_KEY=

# 兼容部分示例代码中的小写变量名（可选，与上一项二选一即可）
zhipuai_api_key=

# OpenAI（可选：GPT 模型与 OpenAI Embedding）
OPENAI_API_KEY=

# 百度文心（可选）
wenxin_api_key=
wenxin_secret_key=

# 讯飞星火（可选）
spark_api_key=
spark_appid=
spark_api_secret=

# 阿里云千问 / 通义千问（可选；DashScope SDK 使用）
DASHSCOPE_API_KEY=

# 兼容部分示例代码中的小写变量名（可选，与上一项二选一即可）
dashscope_api_key=

# ===========================================================================
# 本地 multilingual-e5-large 模型目录（可选）
# ---------------------------------------------------------------------------
# 仅在你已经把模型权重（约 1.2GB）下载到一个固定目录、想避免重复下载/复用时配置。
# 留空（默认）时，embedding/call_embedding.py 会按以下顺序回退：
#   1) HuggingFace 标准缓存（~/.cache/huggingface/hub/）
#   2) 在线下载 intfloat/multilingual-e5-large
#   3) 小模型 sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# 推荐通过项目内置脚本下载，下载结束后会提示你应填入的绝对路径：
#   python tools/download_multilingual_e5.py
# Windows 路径示例（无需引号、无需转义反斜杠）：
#   MULTILINGUAL_E5_PATH=C:\Users\you\.cache\huggingface_models\multilingual-e5-large
# Linux/macOS 路径示例：
#   MULTILINGUAL_E5_PATH=/home/you/.cache/huggingface_models/multilingual-e5-large
MULTILINGUAL_E5_PATH=

# ===========================================================================
# 检索器选择（生产入口 run_gradio.py / api/fast_api.py 共用）
# ---------------------------------------------------------------------------
# dense（默认）: 纯 FAISS 密集向量检索，等同于历史行为，老用户无感升级
# hybrid:      FAISS + BM25(jieba) 通过 RRF（Reciprocal Rank Fusion）融合
#              对中文章节号 / 专有名词 / 编号类查询通常显著优于 dense
#              （pumpkin_book 黄金集实测 mrr 从 0.75 → 0.83，Case3 mrr 翻倍）
#              首次查询会构建 BM25 倒排（一次性几秒），之后命中缓存
# 评估侧使用：python -m evaluation.cli run --retriever {dense,hybrid}
# 详细说明见 evaluation/README.md - Hybrid 检索章节
RETRIEVER_KIND=dense
